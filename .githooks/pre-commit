#!/usr/bin/env bash
# .githooks/pre-commit - git-side pre-commit gate (cheap checks).

set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

step() {
  printf 'pre-commit: %s\n' "$*"
}

step "cargo fmt"
cargo fmt -p agogo-chan -p agogo-core -p agogo-cli -- --check
step "scripts/check_pii.sh"
scripts/check_pii.sh
step "scripts/check_floats.sh"
scripts/check_floats.sh
step "scripts/check_layers.sh"
scripts/check_layers.sh
step "scripts/check_connections.sh"
scripts/check_connections.sh
step "scripts/check_boundary_panics.sh"
scripts/check_boundary_panics.sh

step "OK"
