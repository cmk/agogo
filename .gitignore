# Build
debug/
target/
__pycache__/

# Editor
.vscode/
.idea
**/*.swp
**/*.rs.bk

# OS
**/*.DS_Store

# MCP server config — contains machine-local binary paths
.mcp.json

# Personal project notes (not shared with agents or CI)
doc/notes/

# External
ext/

# `crates/host-link`, `crates/host-cpal`, and `crates/host-midi` are
# detached crates (not workspace members); their own Cargo.lock files
# are auto-generated on standalone `cargo test` runs. The workspace
# Cargo.lock is the authoritative one for CI/cli builds.
crates/host-link/Cargo.lock
crates/host-cpal/Cargo.lock
crates/host-midi/Cargo.lock

# /watch-pr dynamic-mode backoff state (per-PR consecutive-quiet-tick counters)
/.watch-pr/

# Secrets and local environment
.env
.env.*
*.pem
*.key
*_rsa
*_rsa.pub
*.p12
*.pfx

.claude/scheduled_tasks.lock
